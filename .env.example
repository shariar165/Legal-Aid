# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# live | replay | fake   (replay = cache only, no network; fake = deterministic test LLM)
AIN_LLM_MODE=live

# --- user data security ---
# Key that encrypts stored analyses (backend/runs/*.json.enc). Generate one with:
#   .venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left empty, a dev key is created once in backend/.data/secret.key. Losing the key makes stored analyses unreadable.
AIN_DATA_KEY=
# Browser origins allowed to call the API with the session cookie (comma-separated)
AIN_CORS=http://localhost:3000,http://127.0.0.1:3000
# Set to 1 when serving over HTTPS so the session cookie is Secure
AIN_COOKIE_SECURE=0

# --- MCP server ---
# Bearer token for MCP over streamable HTTP (POST /api/mcp). Left empty, the HTTP endpoint is off;
# stdio (python -m ain.mcp_server, from backend/) needs no token. Generate one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(32))"
AIN_MCP_TOKEN=
# Extra Host headers the MCP endpoint accepts besides localhost and SPACE_HOST (comma-separated)
AIN_MCP_HOSTS=

# --- workflow automation (automation/n8n/) ---
# Bearer token for GET /api/corpus/freshness (law freshness watch). Empty = endpoint off (404).
AIN_AUTOMATION_TOKEN=
# Where to POST a count-only digest when an analysis finishes (e.g. the n8n webhook). Empty = off.
#   AIN_WEBHOOK_URL=http://localhost:5678/webhook/ain-job-digest
AIN_WEBHOOK_URL=
