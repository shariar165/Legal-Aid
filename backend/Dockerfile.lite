# Jukti backend only, lite (Railway): BM25 retrieval, no torch / EasyOCR, fits 0.5 GB RAM.
# The UI runs on Vercel and rewrites /api/* here (AIN_INTERNAL_API), so the session cookie stays first-party.
# Build context = the folder made by scripts/railway_up.sh (code, corpus, demo files and the warmed LLM cache;
# never .data, runs/ or .env). The full one-container image for HF Spaces is ../Dockerfile.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 AIN_DENSE=0 AIN_COOKIE_SECURE=1 \
    AIN_DATA_DIR=/data AIN_RUNS_DIR=/data/runs
WORKDIR /app/backend

COPY requirements-lite.txt ./
RUN pip install -r requirements-lite.txt

COPY . .

# Railway's edge and Vercel's proxy sit in front: trust X-Forwarded-For so per-IP rate limits see the real client
CMD ["sh", "-c", "mkdir -p \"$AIN_DATA_DIR\" \"$AIN_RUNS_DIR\" && exec uvicorn ain.api:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
