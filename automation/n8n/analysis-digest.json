    {
      "parameters": {
        "jsCode": "// One log row per finished analysis. The payload has counts only: no file name, no text, no finding.\nreturn $input.all().map(({ json }) => {\n  const d = json.body ?? json;\n  const s = d.risks_by_severity ?? {};\n  return { json: {\n    ...d,\n    received_at: new Date().toISOString(),\n    urgent: (s.critical ?? 0) > 0 || (d.human_review ?? 0) > 0,\n    line: `Ain job ${d.job_id}: ${d.risks} risks (${s.critical ?? 0} critical, ${s.high ?? 0} high), ` +\n          `${d.off_playbook_risks} off-playbook, ${d.claims_verified} claims verified / ${d.claims_dropped} dropped, ` +\n          `${d.human_review} for human review, ${d.destination ?? 'BD'}, ${d.llm_mode}, ${Math.round(d.seconds)} s`,\n  } };\n});"
      },
      "id": "16de402a-f740-5b88-8438-97fe4cc7de6b",
      "name": "Summarise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
